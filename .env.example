# -----------------------------------------------------------------------------
# Secret Santa — variabili d'ambiente
# Copia questo file in `.env.local` (sviluppo) oppure inserisci i valori nelle
# impostazioni del progetto Vercel (produzione). Non committare mai valori reali.
# -----------------------------------------------------------------------------

# --- Supabase (obbligatorie) -------------------------------------------------
# Supabase Dashboard → Project Settings → API / Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://il-tuo-progetto.supabase.co
# Supabase Dashboard → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
# In alternativa funziona anche la chiave legacy "anon". È una chiave PUBBLICA:
# la sicurezza è garantita da Row Level Security.
# NON usare MAI qui la "secret key" / "service_role": l'app non ne ha bisogno.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- URL pubblico del sito (consigliata in produzione) -----------------------
# Usato per costruire i link personali. Se assente si usa il dominio di
# produzione Vercel o, in locale, l'host della richiesta.
NEXT_PUBLIC_SITE_URL=https://il-tuo-secret-santa.vercel.app

# --- Invio automatico delle email (FACOLTATIVO) -------------------------------
# Se SMTP_HOST o SMTP_FROM mancano, l'invio automatico è disattivato e resta
# disponibile l'invito manuale (copia messaggio / WhatsApp / app email).
# Esempio Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=tuo.indirizzo@gmail.com, SMTP_PASSWORD=<password per le app di Google>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Secret Santa <tuo.indirizzo@example.com>"

# Facoltativa (consigliata su Vercel): protegge /api/keepalive, il "battito" giornaliero
# che impedisce la pausa del progetto Supabase gratuito. Usa una stringa casuale lunga.
CRON_SECRET=
